    },
    {
      "id": "id-question-04",
      "op": "next",
      "existing": ["Q-999"],
      "expect": { "ok": false },
      "note": "Capacity boundary exhausted after Q-999"
    },
    {
      "id": "id-question-05",
      "op": "parse",
      "input": "Q-1000",
      "expect": { "ok": false },
      "note": "Malformed four-digit question id"
    }
  ]
