{
  "kind": "ids",
  "version": 1,
  "family": "question",
  "cases": [
    {
      "id": "id-question-01",
      "op": "next",
      "existing": [],
      "expect": { "ok": true, "next": "Q-001" },
      "note": "First question id"
    },
    {
      "id": "id-question-02",
      "op": "next",
      "existing": ["Q-001"],
      "expect": { "ok": true, "next": "Q-002" },
      "note": "Next question id"
    },
    {
      "id": "id-question-03",
      "op": "next",
      "existing": ["Q-001", "Q-024"],
      "expect": { "ok": true, "next": "Q-025" },
