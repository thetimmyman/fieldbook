# Build outputs. `out/` holds the generated edition and its zips; it is never committed.
target/
# A planted backup snapshot of a known-bad fixture is a tracked fixture, not a build output.
!tests/fixtures/state-known-bad/*/target/
out/
# Agent tools keep their state outside the product; Serena's project folder is never committed.
.serena/
# The state folder (journal, queue, asked log, backups) and the intake drop folder hold local data; neither is ever committed.
.fieldbook/
inbox/
# A snapshot test writes its proposed value next to the snapshot; the author reads it and renames it by hand.
*.snap.new
.*.pending-snap
# Deploy-time tooling installs here; the lockfile beside it is committed.
deploy/node_modules/
deploy/.wrangler/
# A local token file for the deploy tool is never committed.
deploy/.env*
deploy/.dev.vars*
