#!/usr/bin/env bash
# Runs before each commit: formatting, spelling and secrets on what is staged.
# `just setup` enables this hook. `just doctor` shows which tool is missing.
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"

for tool in cargo typos gitleaks; do
    command -v "$tool" >/dev/null || { echo "pre-commit: $tool is not on PATH; run: just doctor" >&2; exit 1; }
done

cargo fmt --all --check
git diff --cached --name-only --diff-filter=ACMR -z | xargs -0 --no-run-if-empty typos --force-exclude --
gitleaks git --staged --no-banner --redact .
