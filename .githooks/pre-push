#!/usr/bin/env bash
# Runs before each push: the scans that guard what leaves this machine (secrets in the
# commits not yet on main, and the Corpus under --strict), then the personal denylist.
# The full `just check` is the pull request's job: CI runs it and `ci-ok` requires it.
# `just setup` enables this hook. Never use --no-verify.
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"

push_updates="$(mktemp)"
trap 'rm -f "$push_updates"' EXIT
cat > "$push_updates"

# Git exports this repository's context to hooks. Checks also use scratch repos.
local_git_env="$(git rev-parse --local-env-vars)"
for name in $local_git_env; do
    unset "$name"
done

just scan

# The denylist is a file outside the repository; the step runs on the owner's machine only.
if [ -n "${FIELDBOOK_DENYLIST:-}" ]; then
    cargo xtask denylist "$FIELDBOOK_DENYLIST" --updates "$push_updates"
else
    echo "denylist: FIELDBOOK_DENYLIST is not set, so this local step is skipped"
fi
